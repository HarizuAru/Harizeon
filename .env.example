# --- capacity / operations (uncomment to override; defaults shown) ---
# HARIZEON_RUN_LOOPS=1        # set 0 on every API replica except one
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=15000
# BODY_LIMIT_BYTES=262144
# RATE_LIMIT_ENABLED=true     # defaults to true in production only
# RATE_LIMIT_PER_MIN=300
# RATE_LIMIT_AUTH_PER_MIN=20

# --- sandbox (demo/test only; refused when NODE_ENV=production) ---
# HARIZEON_SANDBOX_HOSTS=sandbox.test

# --- hashing cost (Argon2id; OWASP baseline) ---
# HARIZEON_ARGON2_TIME_COST=2        # 1-10
# HARIZEON_ARGON2_MEMORY_COST=19456  # KiB (19 MiB)
# --- worker probe parallelism ---
# SCAN_PROBE_CONCURRENCY=16          # capped at 64
