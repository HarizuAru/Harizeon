# TLS termination for a single-domain deployment (§07.5).
# Caddy auto-provisions and renews the Let's Encrypt certificate for the domain
# (the DNS A/AAAA record must already point at this host). Everything routes to
# the console, which proxies /api/v1 to the control plane internally.
{$DOMAIN} {
	reverse_proxy web:3000
	encode gzip
}
