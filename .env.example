# Local development environment. Copy to `.env` and adjust. NEVER commit `.env`.
# These are throwaway local credentials only — not for staging or production.

POSTGRES_USER=harizeon
POSTGRES_PASSWORD=harizeon
POSTGRES_DB=harizeon

# Used by the API / migration runner on the host. Inside compose the host is `db`.
DATABASE_URL=postgresql://harizeon:harizeon@localhost:5432/harizeon
REDIS_URL=redis://localhost:6379

# Control-plane secrets (W02+). Generate real values; leave blank in local dev.
# Master key used to envelope-encrypt customer notification-channel secrets (§11).
HARIZEON_MASTER_KEY=
# Session signing secret.
HARIZEON_SESSION_SECRET=
